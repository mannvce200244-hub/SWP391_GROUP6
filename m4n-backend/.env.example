# M4N Backend Environment Configuration Template
# Copy to .env or configure environment variables in your deployment

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/m4n_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT & Session Security Configuration
# JWT_SECRET must be at least 256 bits (32 characters)
JWT_SECRET=your-256-bit-secret-key-for-m4n-dev-environment-change-in-prod-minimum-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_MINUTES=15
COOKIE_SECURE=false

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Development Seed Accounts (Initialized safely for local testing)
M4N_DEV_ADMIN_EMAIL=admin@m4n.vn
M4N_DEV_ADMIN_PASSWORD=Password123!

M4N_DEV_ONLINE_STAFF_EMAIL=staff@m4n.vn
M4N_DEV_ONLINE_STAFF_PASSWORD=Password123!

M4N_DEV_POS_STAFF_EMAIL=pos@m4n.vn
M4N_DEV_POS_STAFF_PASSWORD=Password123!
