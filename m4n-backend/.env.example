# M4N Backend Environment Configuration Template
# Hosting environment variables override the local .env loaded by M4N.
# Production: set SPRING_PROFILES_ACTIVE=prod and follow docs/PRODUCTION_READINESS.md.
# The prod profile validates the schema, uses Secure cookies and rejects unsafe deployment overrides.
# Supply HTTPS FRONTEND_URL / CORS_ALLOWED_ORIGINS / PRODUCT_IMAGE_PUBLIC_BASE_URL
# and an absolute persistent PRODUCT_IMAGE_DIRECTORY; development examples below are not production values.

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/m4n_db
DB_USERNAME=postgres
DB_PASSWORD=

# JWT & Session Security Configuration
# JWT_SECRET must be random and at least 32 UTF-8 bytes.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_MINUTES=15
COOKIE_SECURE=false

# CORS Allowed Origin
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Set true only for a development database and configure a private test password.
SEED_DEV_ACCOUNTS=false
M4N_DEFAULT_TEST_PASSWORD=

# Email OTP through Gmail SMTP. Use a Google app password, never your account password.
# Optional Google customer login; OAuth credentials are separate from Gmail SMTP.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback/google
# Defaults to FRONTEND_URL. Use the same origin as the HTTPS callback on hosting.
GOOGLE_FRONTEND_URL=http://localhost:5173

OTP_EMAIL_ENABLED=false
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
POS_INVOICE_EMAIL_ENABLED=true

# GHN fee/address integration; staging by default. Shop must have a configured pickup address.
GHN_ENABLED=false
GHN_PRODUCTION=false
GHN_TOKEN=
GHN_SHOP_ID=0

# Persist this directory across deployments and back it up with the database.
PRODUCT_IMAGE_DIRECTORY=./data/product-images
PRODUCT_IMAGE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/media

# Optional Resend reset delivery. FROM must be a verified sender; HTTPS frontend URL outside loopback.
RESET_EMAIL_ENABLED=false
RESEND_API_KEY=
RESET_EMAIL_FROM=

# One-time first SUPER_ADMIN provisioning. Disable and remove credentials after initial startup.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=

# Real VNPay sandbox credentials; register public HTTPS IPN URL with VNPay.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
VNPAY_SERVER_IP=

# Real MoMo sandbox merchant credentials; callbacks must be reachable public HTTPS URLs.
MOMO_ENABLED=false
# Set true only for an intentional hosted sandbox demo with the prod profile.
# See docs/VERCEL_RAILWAY_DEPLOYMENT.md. This does not enable real-money MoMo.
MOMO_SANDBOX_DEPLOYMENT_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# Install a licensed Unicode TTF with Vietnamese glyphs on the server, then provide its absolute path.
# If omitted, common Windows/Linux Unicode fonts are tried; no lossy Helvetica fallback.
INVOICE_PDF_FONT_PATH=
