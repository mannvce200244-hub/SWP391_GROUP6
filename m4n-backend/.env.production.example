# Public callback settings for the Vercel/Railway demo.
# Copy into Railway Variables, keep existing database/provider secrets there,
# and redeploy. This file is a template; Spring does not load it automatically.
FRONTEND_URL=https://swp-391-group-6-acqc.vercel.app
CORS_ALLOWED_ORIGINS=https://swp-391-group-6-acqc.vercel.app
# Missing-Origin fallback must also belong to CORS_ALLOWED_ORIGINS.
VNPAY_RETURN_URL=https://swp-391-group-6-acqc.vercel.app/payment-return
VNPAY_IPN_URL=https://swp391group6-production.up.railway.app/api/v1/payments/vnpay/ipn
MOMO_REDIRECT_URL=https://swp-391-group-6-acqc.vercel.app/payment-return
MOMO_IPN_URL=https://swp391group6-production.up.railway.app/api/v1/payments/momo/ipn
GOOGLE_FRONTEND_URL=https://swp-391-group-6-acqc.vercel.app
GOOGLE_REDIRECT_URI=https://swp-391-group-6-acqc.vercel.app/api/v1/auth/google/callback/google
PRODUCT_IMAGE_PUBLIC_BASE_URL=https://swp391group6-production.up.railway.app/api/v1/media
SEED_DEV_ACCOUNTS=false
# Email OTP through HTTPS on Railway Free/Trial/Hobby.
OTP_EMAIL_ENABLED=true
OTP_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
OTP_EMAIL_FROM=
